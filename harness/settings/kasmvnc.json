{
  "stack": "kasmvnc",
  "groups": { "server": "Xkasmvnc argument, -Key value", "client": "web client URL parameter (vnc.html?key=value)" },
  "settings": [
    { "group": "server", "key": "depth", "value": "24", "role": "harness", "why": "24-bit, like every X server" },
    { "group": "server", "key": "dpi", "value": "96", "role": "harness", "why": "the same DPI as every X server" },
    { "group": "server", "key": "ac", "value": "", "role": "harness", "why": "no X access control, like every X server" },
    { "group": "server", "key": "SecurityTypes", "value": "None", "role": "harness", "why": "the harness's browser signs in to nothing" },
    { "group": "server", "key": "DisableBasicAuth", "value": "1", "role": "harness", "why": "the harness's browser signs in to nothing" },
    { "group": "server", "key": "sslOnly", "value": "0", "role": "harness", "why": "plain HTTP on loopback" },
    { "group": "server", "key": "AcceptSetDesktopSize", "value": "0", "role": "harness", "why": "the desktop stays at the mode's size" },
    { "group": "server", "key": "FreeKeyMappings", "value": "", "role": "harness", "why": "the typing test's keys reach the X server" },
    { "group": "server", "key": "IgnoreClientSettingsKasm", "value": "0", "role": "harness", "why": "honour the client's settings, so the URL below picks the stream mode" },
    { "group": "server", "key": "fakescreenfps", "value": "{fps}", "role": "harness", "why": "the same X server clock as every stack" },

    { "group": "server", "key": "FrameRate", "value": "{fps}", "why": "the mode's frame rate" },
    { "group": "server", "key": "videoCodec", "value": "h264", "only": ["kasm-ws"], "why": "software H.264, the baseline codec" },
    { "group": "server", "key": "GroupOfPicture", "value": "60", "only": ["kasm-ws"], "why": "KasmVNC caps the GOP at 60 frames" },
    { "group": "server", "key": "VideoQualityCRFCQP", "value": "{crf}", "only": ["kasm-ws"], "why": "CRF calibrated per mode (calibrate) so the p95 rate on the drag reference stays under the bitrate ceiling" },

    { "group": "client", "key": "autoconnect", "value": "1", "role": "harness", "why": "connect on load" },
    { "group": "client", "key": "resize", "value": "off", "role": "harness", "why": "the desktop stays at the mode's size" },
    { "group": "client", "key": "view_clip", "value": "0", "role": "harness", "why": "the whole desktop on the page" },
    { "group": "client", "key": "enable_hidpi", "value": "0", "role": "harness", "why": "1:1 pixels" },
    { "group": "client", "key": "clipboard_up", "value": "0", "role": "harness", "why": "not under test" },
    { "group": "client", "key": "clipboard_down", "value": "0", "role": "harness", "why": "not under test" },
    { "group": "client", "key": "clipboard_seamless", "value": "0", "role": "harness", "why": "not under test" },
    { "group": "client", "key": "logging", "value": "warn", "role": "harness", "why": "quiet console" },
    { "group": "client", "key": "enable_webrtc", "value": "0", "only": ["kasm-ws", "kasm-ws-hybrid"], "role": "harness", "why": "the WebSockets column" },
    { "group": "client", "key": "enable_webrtc", "value": "1", "only": ["kasm-rtc-hybrid"], "role": "harness", "why": "the WebRTC column" },

    { "group": "client", "key": "video_rendering_mode", "value": "canvas2d", "why": "no GPU in the baseline" },
    { "group": "client", "key": "video_quality", "value": "10", "why": "the custom preset, so the values below apply (the default Medium preset forces 24 fps)" },
    { "group": "client", "key": "framerate", "value": "{fps}", "why": "the mode's frame rate" },
    { "group": "client", "key": "framerate_streaming_mode", "value": "{fps}", "why": "the mode's frame rate" },
    { "group": "client", "key": "framerate_image_mode", "value": "{fps}", "why": "the mode's frame rate" },
    { "group": "client", "key": "stream_mode", "value": "-1027", "only": ["kasm-ws"], "why": "the H.264 stream mode" },
    { "group": "client", "key": "stream_mode", "value": "-1025", "only": ["kasm-ws-hybrid", "kasm-rtc-hybrid"], "why": "the lossless/JPEG/WebP hybrid" },
    { "group": "client", "key": "video_stream_quality", "value": "{51-crf}", "only": ["kasm-ws"], "why": "the client's quality knob, set to match the server CRF" },
    { "group": "client", "key": "gop", "value": "60", "only": ["kasm-ws"], "why": "matches GroupOfPicture" },
    { "group": "client", "key": "quality", "value": "9", "ships": "6", "why": "best still quality" },
    { "group": "client", "key": "compression", "value": "2", "why": "" },
    { "group": "client", "key": "dynamic_quality_min", "value": "7", "why": "" },
    { "group": "client", "key": "dynamic_quality_max", "value": "8", "why": "" },
    { "group": "client", "key": "treat_lossless", "value": "9", "why": "" },
    { "group": "client", "key": "video_area", "value": "100", "why": "" },
    { "group": "client", "key": "video_time", "value": "100", "why": "" },
    { "group": "client", "key": "video_out_time", "value": "3", "why": "" },
    { "group": "client", "key": "video_scaling", "value": "0", "why": "no downscaling in motion" },
    { "group": "client", "key": "enable_threading", "value": "1", "why": "" }
  ]
}
